{
  "name": "pronounceall",
  "version": "0.1.0",
  "description": "Free, open-source pronunciation reference and practice tool for English learners.",
  "license": "AGPL-3.0-or-later",
  "author": "Alp Kavaklı",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpkavakli/PronounceAll.git"
  },
  "homepage": "https://pronounceall.com",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "lint:licence": "node scripts/check-licence-headers.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration",
    "test:e2e": "playwright test",
    "migrate": "docker compose run --rm flyway migrate",
    "migrate:info": "docker compose run --rm flyway info"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.0",
    "mysql2": "^3.15.4",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.57.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "supertest": "^7.1.4"
  }
}
