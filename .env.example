# PronounceAll environment configuration (NFR-SEC-06, SDD v1.1 §6.4).
#
# Copy to .env and fill in local development values:
#     cp .env.example .env
#
# Every variable the application requires is listed here with a placeholder and
# a one-line description. NO REAL SECRET VALUE IS EVER COMMITTED TO THIS FILE.
# `.env` is git-ignored and CI runs a secret scanner over every commit.
#
# The configuration module (src/config/) validates this set once at startup and
# fails fast in staging and production when a required variable is absent or
# malformed, so a misconfiguration surfaces at boot rather than at first use.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Deployment environment: development | test | staging | production
NODE_ENV=development
# TCP port the Express application listens on
PORT=3000
# Public origin of the deployment, used for absolute URLs and cookie scoping
APP_BASE_URL=http://localhost:3000
# Number of proxy hops in front of Express (Cloudflare + Nginx = 2 in production)
TRUST_PROXY_HOPS=0
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# MySQL 8 — system of record (SDD v1.1 §3.2)
# ---------------------------------------------------------------------------
# Hostname of the MySQL server
MYSQL_HOST=127.0.0.1
# Port of the MySQL server
MYSQL_PORT=3306
# Application schema name
MYSQL_DATABASE=pronounceall
# Application role. Holds no destructive privilege on the history-of-record
# tables (B1); erasure runs under a separate credential the app never receives.
MYSQL_USER=pronounceall_app
# Password for the application role
MYSQL_PASSWORD=replace-me-in-your-local-env
# Maximum pooled connections
MYSQL_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Redis — sessions, rate-limit counters, idempotency store, BullMQ queues (V2)
# ---------------------------------------------------------------------------
# Redis connection URL
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# Rate limiting (NFR-SEC-11, Foundational Decisions §10.3)
# ---------------------------------------------------------------------------
# Counter store: redis | memory. `memory` is for LOCAL DEVELOPMENT ONLY — the
# configuration module rejects it in staging and production, where counters must
# survive a restart and hold across processes.
RATE_LIMIT_STORE=redis

# ---------------------------------------------------------------------------
# Audio assets (V4, FR-CONTENT-04)
# ---------------------------------------------------------------------------
# Where pre-generated audio is stored on local disk. Filenames are
# content-addressed and immutable, so a changed asset is a new file and nothing
# is ever invalidated. In production Nginx serves this directory directly.
AUDIO_STORAGE_ROOT=data/audio
# URL prefix the audio is served under, matching the Nginx location block.
AUDIO_PUBLIC_PREFIX=/audio

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — word-request form gate (FR-WORD-05)
# ---------------------------------------------------------------------------
# The SITE key is public: it identifies the widget to the browser. The SECRET
# key is a credential and must never be committed. Both are REQUIRED in staging
# and production; leaving them empty locally runs the form without upstream
# verification, which the application logs a warning about at boot.
# Obtain a pair from the Cloudflare dashboard: Turnstile > Add site.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# HMAC key for the stateless CSRF token (FR-AUTH-20, SDD §6.6). At least 32
# characters; required in staging and production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CSRF_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare cache purge on re-seed (SDD v1.1 §6.3)
# ---------------------------------------------------------------------------
# The word-page shell is edge-cached, so a re-seed purges the affected URLs.
# Iteration 1 ships the adapter seam only; credentials arrive with the
# production-edge work. Left empty, the pipeline purges nothing and says so —
# it never fakes a purge. The token is scoped to cache purge on one zone.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_TOKEN=

# ---------------------------------------------------------------------------
# Outgoing email — verification and password reset (FR-AUTH-09/11)
# ---------------------------------------------------------------------------
# Plain SMTP. The defaults below point at the DEVELOPMENT-ONLY Mailpit catcher
# (`docker compose up -d mailpit`; read the mail at http://localhost:8025).
# Staging and production refuse to boot without SMTP_HOST, SMTP_USER,
# SMTP_PASSWORD and MAIL_FROM, so the Mailpit defaults can never be used there.
# The production relay is not chosen in code (SDD Round 1 Decision V5 is
# provisional).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# true for implicit TLS (usually port 465); false for plain or STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# The sender shown to recipients
MAIL_FROM=PronounceAll <no-reply@pronounceall.localhost>

# ---------------------------------------------------------------------------
# Google sign-in (FR-AUTH-04a, FR-AUTH-16)
# ---------------------------------------------------------------------------
# A "Web application" OAuth client from Google Cloud Console > APIs & Services
# > Credentials. The secret is a credential: never commit it, and it never
# reaches the browser. Left empty locally, the Google path is simply not
# offered; staging and production refuse to boot without both values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" registered on that client exactly.
# Defaults to APP_BASE_URL + /auth/google/callback, e.g.
#   http://localhost:3000/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Privacy and data protection (FR-CONSENT-03, FR-SET-07)
# ---------------------------------------------------------------------------
# The version of the published privacy policy that consents are recorded
# against. Locally it defaults to "unpublished-draft".
# PRIVACY_POLICY_VERSION=1.0
# A monitored mailbox for data-protection requests; named as the "this wasn't
# me" contact in account-deletion emails. Locally it defaults to a placeholder
# that reaches no one. Staging and production refuse to boot without both.
# CONTACT_EMAIL=privacy@example.org

# ---------------------------------------------------------------------------
# Background workers (SDD §6.5)
# ---------------------------------------------------------------------------
# The maintainer's address for a background job that failed after every retry.
# Optional for the web process; staging and production workers refuse to start
# without it. Each worker also runs with its own MYSQL_USER / MYSQL_PASSWORD:
# pa_erase (erasure worker), pa_maint (maintenance), pa_app (app worker).
# OPS_ALERT_EMAIL=ops@example.org
