# Secrets — NFR-SEC-06. Never commit a real secret value.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build and tool output
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Runtime data. `data/seed/` is the ONE exception and is deliberately
# committed: FR-CONTENT-01 requires the seed to be deterministic and
# reproducible from a documented command, which holds only because the load
# stage reads a fixed, reviewed artifact rather than re-fetching a Wiktionary
# that changes under it. CI seeds from these files too (E1).
# Note the shape: a wholly excluded directory cannot have its contents
# re-included, so `data/` is excluded by its CONTENTS and `data/seed/` is
# negated before anything below it is considered.
/data/*
!/data/seed/
logs/
*.log

# Offline content tooling (V1). Piper runs as a separate batch tool at content
# build time and is NOT a runtime dependency, so its virtualenv and the
# ~131 MB voice model stay out of the application repository. Both are
# reproducible: `docs/process` records the install commands, and
# `data/seed/en-us.piper-profile.json` pins the package version plus the model
# and config SHA-256 digests that the generation preflight enforces.
/tools/piper/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

