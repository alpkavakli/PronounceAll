<%# PronounceAll — Copyright (C) 2026 Alp Kavaklı
    SPDX-License-Identifier: AGPL-3.0-or-later
    See LICENSE-NOTICE.md at the repository root.

    `metaDescription` and `canonicalUrl` are optional (FR-WORD-09): the word
    page supplies both. A page without its own description gets the site's, so
    every page carries one (NFR-PERF-03 SEO). %>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · PronounceAll</title>
<meta name="description" content="<%= (typeof metaDescription !== 'undefined' && metaDescription) || 'PronounceAll is a free, open-source English pronunciation dictionary: IPA transcriptions, audio and practice for learners.' %>">
<% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
<link rel="canonical" href="<%= canonicalUrl %>">
<% } %>
<%# No icon is designed yet. An explicitly empty one stops the browser's automatic
    /favicon.ico request, whose 404 is a console error (NFR-PERF-03, Best
    Practices). Replace with the real icon when there is one. %>
<link rel="icon" href="data:,">
<link rel="stylesheet" href="/css/main.css">
