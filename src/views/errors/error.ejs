    SPDX-License-Identifier: AGPL-3.0-or-later
    See LICENSE-NOTICE.md at the repository root.

    The error view carries no inline script or style, so it renders correctly
    under both the nonce-free shell policy and the per-request nonce policy
    (SDD v1.1 §6.1, amended NFR-SEC-03). %>
<!doctype html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Something went wrong' }) %>
</head>
<body>
  <main class="page">
    <h1><%= status %></h1>
    <p><%= message %></p>
    <p class="error-reference">
      Reference: <code><%= correlationId %></code>
    </p>
    <p><a href="/">Back to the home page</a></p>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
