    See LICENSE-NOTICE.md at the repository root.

    Settings (FR-SET-01/02/03/04/05/06/10). One page for everyone: the account
    section is for signed-in users and explains itself to everyone else; the
    cookie preferences and the language selector are for all. Plain forms, so
    it works without JavaScript. DYNAMIC (private, no-store). %>
<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title: title }) %>
</head>
<body>
  <main class="page settings">
    <h1>Settings</h1>

    <% if (notice) { %>
      <p class="notice" role="status"><%= notice %></p>
    <% } %>
    <% if (linkProblem) { %>
      <p class="account__error" role="alert"><%= linkProblem %></p>
    <% } %>

    <section class="settings__section" aria-labelledby="settings-account">
      <h2 id="settings-account" class="section-heading">Account</h2>
      <% if (signedIn && account) { %>
        <p>Signed in as <strong><%= account.username %></strong><% if (account.provider === 'google') { %> with Google<% } %>.</p>
        <% if (account.email) { %>
          <p>Email: <%= account.email %><%= account.emailVerifiedAt ? '' : ' (not yet confirmed)' %></p>
        <% } %>

        <% if (account.provider === 'google') { %>
          <p class="account__help">Your password and email are managed by Google.</p>
        <% } else { %>
          <%# FR-SET-02: change password — the current one is required. %>
          <h3 class="settings__subheading">Change password</h3>
          <% if (passwordError) { %>
            <p class="account__error" role="alert"><%= passwordError %></p>
          <% } %>
          <form class="account__form" method="post" action="/settings/password">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="account__label" for="settings-current-password">Current password</label>
            <input class="account__input" id="settings-current-password" name="currentPassword" type="password"
                   autocomplete="current-password" required maxlength="100">
            <label class="account__label" for="settings-new-password">New password</label>
            <input class="account__input" id="settings-new-password" name="newPassword" type="password"
                   autocomplete="new-password" required minlength="8" maxlength="100"
                   aria-describedby="settings-new-password-help">
            <p class="account__help" id="settings-new-password-help">At least 8 characters. Passwords found in known data breaches are refused. Every other device will be signed out.</p>
            <button type="submit" class="button">Change password</button>
          </form>

          <%# FR-SET-02: change email — confirmed by a link to the new address; the
              current one stays active until then. %>
          <h3 class="settings__subheading"><%= account.email ? 'Change email' : 'Add an email' %></h3>
          <% if (account.pendingEmail) { %>
            <p class="notice" role="status">Waiting for confirmation of <strong><%= account.pendingEmail %></strong>. Check that inbox for the link.</p>
          <% } %>
          <% if (emailError) { %>
            <p class="account__error" role="alert"><%= emailError %></p>
          <% } %>
          <form class="account__form" method="post" action="/settings/email">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="account__label" for="settings-new-email">New email</label>
            <input class="account__input" id="settings-new-email" name="email" type="email" value="<%= emailValue %>"
                   autocomplete="email" required maxlength="320">
            <label class="account__label" for="settings-email-password">Current password</label>
            <input class="account__input" id="settings-email-password" name="currentPassword" type="password"
                   autocomplete="current-password" required maxlength="100">
            <button type="submit" class="button">Send confirmation link</button>
          </form>
        <% } %>

        <%# FR-SET-02/07: opens the two-step deletion flow. %>
        <h3 class="settings__subheading">Delete account</h3>
        <p class="account__help">Close your account, with 30 days to change your mind, or erase it for good.</p>
        <p><a href="/settings/delete">Delete my account…</a></p>

        <form method="post" action="/logout" class="settings__inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="button button--secondary">Sign out</button>
        </form>
      <% } else { %>
        <%# FR-SET-01/10: account management needs an account; say so rather than hide it silently. %>
        <p>Account management — email, password, sign-out and deleting your account — is available once you have an account.</p>
        <p><a class="button" href="/register">Create an account</a> <a href="/login">Sign in</a></p>
      <% } %>
    </section>

    <section class="settings__section" aria-labelledby="settings-cookies">
      <h2 id="settings-cookies" class="section-heading">Cookie preferences</h2>
      <form method="post" action="/settings/cookies" class="settings__cookies">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <fieldset>
          <legend>Strictly necessary</legend>
          <p class="account__help">These keep the site working and cannot be turned off.</p>
          <% essentialCookies.forEach(function (cookie) { %>
            <p class="account__check">
              <input type="checkbox" id="cookie-<%= cookie.name %>" checked disabled aria-describedby="cookie-<%= cookie.name %>-why">
              <label for="cookie-<%= cookie.name %>"><code><%= cookie.name %></code></label>
            </p>
            <p class="account__help" id="cookie-<%= cookie.name %>-why"><%= cookie.purpose %></p>
          <% }); %>
        </fieldset>
        <fieldset>
          <legend>Optional</legend>
          <p class="account__check">
            <input type="checkbox" id="cookie-ads" name="ads" value="on"<%= adsEnabled ? ' checked' : '' %> aria-describedby="cookie-ads-why">
            <label for="cookie-ads">Enable ads</label>
          </p>
          <p class="account__help" id="cookie-ads-why">Off unless you turn it on. No ads are shown yet; this records your choice for when they are.</p>
        </fieldset>
        <button type="submit" class="button">Save preferences</button>
      </form>
    </section>

    <section class="settings__section" aria-labelledby="settings-language">
      <h2 id="settings-language" class="section-heading">Language</h2>
      <label class="account__label" for="settings-variant">Dictionary</label>
      <select class="account__input" id="settings-variant" aria-describedby="settings-variant-help">
        <% languageVariants.forEach(function (variant) { %>
          <option value="<%= variant.code %>" selected><%= variant.name %></option>
        <% }); %>
      </select>
      <p class="account__help" id="settings-variant-help">American English is the only dictionary for now. More languages and accents are planned.</p>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script type="module" src="/js/bootstrap.js"></script>
</body>
</html>
