<!doctype html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head', { title: title, metaDescription: metaDescription, canonicalUrl: canonicalUrl }) %>
</head>
<body>
  <main class="page legal">
    <h1><%= heading %></h1>
    <p class="notice legal__draft" role="note"><%= draftNotice %></p>
    <div class="legal__text">
      <%- html %>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script type="module" src="/js/bootstrap.js"></script>
</body>
</html>
