<%# PronounceAll — Copyright (C) 2026 Alp Kavaklı
    SPDX-License-Identifier: AGPL-3.0-or-later
    See LICENSE-NOTICE.md at the repository root.

    The word page: the B2 CACHEABLE SHELL (SDD v1.1 §3.4, §5.3, §6.3).

    This response is identical for every viewer of the word and is cached at the
    edge, which fixes three properties of this template:

      1. No inline <script> and no inline <style>. The shell cannot carry a
         per-response CSP nonce, so it takes the nonce-free `script-src 'self'`
         policy (amended NFR-SEC-03) and every asset is external.
      2. Nothing per-viewer. Save/tag state and the FR-WORD-06 progress banner
         belong to the hydration layer (B2): the save control here is a
         viewer-neutral link that the script upgrades after hydration.
      3. Everything below reads with JavaScript disabled (FR-WORD-08).

    ITERATION 2 completes FR-WORD-03. The IPA is built from the stored
    `pronunciation_phonemes` occurrences, so each phoneme is a clickable element
    with a stable `data-phoneme-id` (FR-IPA-02) and no IPA is parsed at render.

    Audio appears only where a REAL asset is ready. A pending asset renders no
    control at all, on the same rule Iteration 1 applied: a control that cannot
    play is worse than temporarily leaving it out. %>
<!doctype html>
<html lang="<%= variant.code %>">
<head>
  <%- include('partials/head', { title: title, metaDescription: metaDescription, canonicalUrl: canonicalUrl }) %>
  <%# FR-IPA-06: preload the phoneme audio this word actually uses, so a click
      is audible inside the FR-IPA-04 budget. Distinct keys only, and only for
      units whose asset is ready. The learnIPA pages deliberately emit none of
      these and lazy-load instead. %>
  <% preloadAudioKeys.forEach((storageKey) => { %>
  <link rel="preload" as="audio" href="<%= audioPublicPrefix %>/<%= storageKey %>">
  <% }); %>
</head>
<body>
  <main class="page word-page" data-viewer-variant="<%= variant.code %>" data-encounter-word="<%= word.wordId %>">
    <%# FIND-10: look up the next word without going back to the home page.

        Safe on the cacheable shell: a plain GET form is static markup, identical
        for every viewer of this word, and carries no script, style, or state. It
        changes nothing about the response class. %>
    <%- include('partials/search-form', { variantCode: variant.code }) %>

    <article class="word">
      <header class="word__header">
        <h1 class="word__headword"><%= word.displayHeadword %></h1>
        <p class="word__variant"><%= variant.displayName %></p>
        <%# FR-SAVE-01/07: viewer-neutral on the cached shell. Without JavaScript
            it links to the uncached confirmation page; the script upgrades it
            to the save button once hydration reports the viewer's state. %>
        <a class="save-control" data-save-control data-target-kind="word"
           data-target-id="<%= word.wordId %>" data-target-label="<%= word.displayHeadword %>"
           href="/save/confirm?kind=word&amp;id=<%= word.wordId %>&amp;return=<%= encodeURIComponent(pagePath) %>">Save</a>
      </header>

      <%# FR-WORD-06: the progress-aware banner. The shell carries the viewer-
          neutral invitation with N from the `phonemes` table; hydration swaps
          in "M/N — doing great! K to go" once the viewer has learned a phoneme. %>
      <p class="ipa-banner" data-ipa-banner data-total="<%= phonemeTotal %>">
        <a class="ipa-banner__link" href="/<%= variant.code %>/learnIPA">Learn every sound in English! Just learn these <%= phonemeTotal %> IPA symbols to pronounce every word</a>
      </p>

      <%# FR-WORD-03: every pronunciation from `word_pronunciations`, in
          `display_order`, with the single `is_primary` row leading. A heteronym
          such as `lead` renders each of its pronunciations here. %>
      <section class="pronunciations" aria-labelledby="pronunciations-heading">
        <h2 id="pronunciations-heading" class="section-heading">Pronunciation</h2>

        <%# FR-WORD-03 (SRS 1.0.4), baseline §7.4: the transcription convention,
            once per page, with its help text in a native disclosure — keyboard
            and screen-reader operable, not hover-only, and present without
            JavaScript. %>
        <details class="ipa-convention">
          <summary class="ipa-convention__label">Broad en-US IPA</summary>
          <p class="ipa-convention__help">PronounceAll uses a consistent learner-oriented phonemic transcription. Other dictionaries may use different IPA conventions for the same pronunciation.</p>
        </details>

        <ul class="pronunciation-list">
          <% pronunciations.forEach(function (pronunciation) { %>
            <li class="pronunciation<%= pronunciation.isPrimary ? ' pronunciation--primary' : '' %>">
              <% if (pronunciation.gloss) { %>
                <p class="pronunciation__gloss"><%= pronunciation.gloss %></p>
              <% } %>

              <%# FR-IPA-02: every phoneme is a clickable element carrying a
                  stable `data-phoneme-id`, composed from the stored
                  `pronunciation_phonemes` occurrences. No IPA is parsed here —
                  tokenisation happened once, server-side, at seed time.

                  Each unit is a <button> rather than a <span> with a handler:
                  that gives keyboard focus and Enter/Space activation for free
                  (NFR-A11Y-08 wants every control operable by at least two of
                  pointer, touch, keyboard), and without JavaScript it is simply
                  an inert button whose text still reads as the transcription
                  (FR-WORD-08).

                  Where the seed has not produced occurrences the static string
                  is rendered instead, so the page never loses its IPA. %>
              <p class="pronunciation__ipa">
                <span class="visually-hidden">IPA transcription: </span>
                <% if (pronunciation.occurrences.length > 0) { %>
                  <%# Stress and syllable marks sit inline with the units they
                      belong to (D4 §3.8, baseline §8.3), so the line reads
                      `/ˈoʊ.pən/` rather than `oʊpən`. `displaySegments` is
                      null when the marks could not be aligned exactly; the
                      transcription then renders as the bare unit sequence, the
                      output this page produced before. %>
                  <% const segments = pronunciation.displaySegments
                       || pronunciation.occurrences.map(function (occurrence) {
                            return { type: 'phoneme', occurrence };
                          }); %>
                  <span class="ipa" lang="und-fonipa"><span class="ipa__slash" aria-hidden="true">/</span><% segments.forEach(function (segment) { if (segment.type === 'mark') { %><span class="ipa__mark"><%= segment.text %></span><% } else { const occurrence = segment.occurrence; %><button
                      type="button"
                      class="phoneme"
                      data-phoneme-id="<%= occurrence.phonemeId %>"
                      data-symbol="<%= occurrence.ipaSymbol %>"
                      aria-label="phoneme /<%= occurrence.ipaSymbol %>/"
                      <% if (occurrence.detail && occurrence.detail.exampleWord) { %>data-example-word="<%= occurrence.detail.exampleWord %>"<% } %>
                      <% if (occurrence.detail && occurrence.detail.examplePhonemicTranscription) { %>data-example-ipa="<%= occurrence.detail.examplePhonemicTranscription %>"<% } %>
                      <% if (occurrence.detail && occurrence.detail.audioStorageKey) { %>data-audio="<%= audioPublicPrefix %>/<%= occurrence.detail.audioStorageKey %>"<% } %>
                    ><%= occurrence.ipaSymbol %></button><% } }); %><span class="ipa__slash" aria-hidden="true">/</span></span>
                <% } else { %>
                  <span class="ipa" lang="und-fonipa"><span class="ipa__slash" aria-hidden="true">/</span><%= pronunciation.ipaTranscription %><span class="ipa__slash" aria-hidden="true">/</span></span>
                <% } %>
                <% if (!pronunciation.isPrimary) { %>
                  <span class="pronunciation__badge">also</span>
                <% } %>
              </p>

              <%# SDD §4.12, D-R3-08: a pronunciation gets an audio control ONLY
                  when an asset is known to correspond to THAT pronunciation.
                  Primary audio is never reused for a secondary pronunciation,
                  and a runtime Web Speech fallback is never presented as though
                  it were a specific secondary pronunciation. With no asset the
                  control is simply absent.

                  The native <audio controls> element is the FR-IPA-05 no-
                  JavaScript fallback: it plays without any script at all. %>
              <% if (pronunciation.audioStorageKey) { %>
                <p class="pronunciation__audio">
                  <audio controls preload="none" src="<%= audioPublicPrefix %>/<%= pronunciation.audioStorageKey %>"
                         data-listen-kind="word" data-listen-id="<%= word.wordId %>">
                    Your browser cannot play this recording.
                  </audio>
                </p>
              <% } else if (pronunciation.isPrimary) { %>
                <%# FR-IPA-05 tier 3: with no server-side asset for the PRIMARY
                    pronunciation, the last resort is the visitor's own Web
                    Speech API. It is offered only here — D-R3-08 forbids
                    presenting an uncontrolled synthesis as though it were a
                    specific secondary pronunciation.

                    Rendered hidden and unhidden by the script only where
                    speechSynthesis actually exists, so a no-JS or unsupported
                    browser is never shown a control that cannot speak. The
                    failure message is a live region: FR-IPA-05 requires a
                    visible error rather than a silent failure. %>
                <p class="pronunciation__audio">
                  <button type="button" class="pronunciation__speak" hidden
                          data-speak="<%= word.displayHeadword %>"
                          data-lang="<%= variant.code %>"
                          data-word-id="<%= word.wordId %>">
                    Play <span class="visually-hidden"><%= word.displayHeadword %></span>
                  </button>
                  <span class="pronunciation__audio-status" role="status" hidden></span>
                </p>
              <% } %>

              <%# FR-WORD-03: the written syllable and stress breakdown, marking
                  primary stress with ˈ and secondary stress with ˌ. %>
              <p class="pronunciation__syllables">
                <span class="visually-hidden">Syllables and stress: </span>
                <span class="syllables" lang="und-fonipa"><%= pronunciation.syllableBreakdown %></span>
              </p>

              <%# SDD §4.2: a pronunciation that does not come from the word's
                  Wiktionary entry names its own source. A Wiktionary row
                  inherits the footer attribution and gets no label. %>
              <% if (pronunciation.sourceKind === 'cmudict') { %>
                <p class="pronunciation__source">
                  Pronunciation source:
                  <a href="<%= pronunciation.sourceReference %>" rel="noopener noreferrer">CMU Pronouncing Dictionary</a>
                </p>
              <% } %>
            </li>
          <% }); %>
        </ul>
      </section>

      <section class="meaning" aria-labelledby="meaning-heading">
        <h2 id="meaning-heading" class="section-heading">Meaning</h2>
        <p class="meaning__text"><%= word.meaning %></p>
      </section>

      <%# FR-CONTENT-05 and NFR-LEGAL-05: the upstream source and its licence,
          visibly attributed with a link to the source entry. CC BY-SA 4.0
          requires this, and Charter §7 pledges to preserve upstream terms. %>
      <footer class="attribution">
        <p>
          Meaning from
          <a href="<%= word.sourceUrl %>" rel="noopener noreferrer"><%= sourceName %></a>
          · <%= word.sourceLicence %>
        </p>
      </footer>
    </article>
  </main>

  <%- include('partials/footer') %>
  <script type="module" src="/js/bootstrap.js"></script>
  <%# FR-IPA-02/03: the popover is a progressive enhancement over markup that
      already reads without it. External module, so the nonce-free shell CSP
      (`script-src 'self'`) admits it. %>
  <script type="module" src="/js/save-control.js"></script>
  <script type="module" src="/js/learner-state.js"></script>
  <script type="module" src="/js/phoneme-popover.js"></script>
  <%# FR-IPA-05 tier 3. Only reveals a control where the browser can actually
      speak; every word with a server-side asset already played without it. %>
  <script type="module" src="/js/whole-word-audio.js"></script>
  <%# FR-SAVE-10: after hydration, only for a viewer who already has progress. %>
  <script type="module" src="/js/word-encounter.js"></script>
  <%# FR-AUTH-17: after hydration, only for a signed-out visitor with 5+ saves. %>
  <script type="module" src="/js/registration-nudge.js"></script>
</body>
</html>
